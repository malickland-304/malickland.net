# Resend transactional email used by /api/contact (https://resend.com).
# RESEND_API_KEY is the only required secret. CONTACT_EMAIL_FROM must be on a
# Resend-verified domain (malickland.net); CONTACT_EMAIL_TO is the inbox that
# receives the leads. FROM/TO have sensible defaults if left unset.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=MalickLand Contact Form <contact@malickland.net>
CONTACT_EMAIL_TO=phil@malickland.net
# Optional send timeout override in milliseconds (default 5000).
CONTACT_EMAIL_TIMEOUT_MS=

# Optional /api/contact abuse protection.
# Production should set the Redis REST values for a durable cross-instance limit.
# Local development falls back to an in-memory per-runtime limiter.
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_TRUST_PROXY_HEADERS=
CONTACT_RATE_LIMIT_REDIS_REST_URL=
CONTACT_RATE_LIMIT_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_REDIS_TIMEOUT_MS=1500

# Optional durable lead backup (LAUNCH_CHECKLIST.md §B "no lead silently drops").
# When both are set, every validated contact submission is also written to the
# Supabase `contact_leads` table (insert-only; see supabase/migrations/).
# LEAD_BACKUP_SUPABASE_KEY is the *publishable* (anon) key — not the service key.
LEAD_BACKUP_SUPABASE_URL=
LEAD_BACKUP_SUPABASE_KEY=
# Optional insert timeout override in milliseconds (default 3000).
LEAD_BACKUP_TIMEOUT_MS=
