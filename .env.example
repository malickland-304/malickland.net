# Gmail account used by /api/contact to send form submissions.
# Use a Gmail app password, not the normal account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional /api/contact abuse protection.
# Production should set the Redis REST values for a durable cross-instance limit.
# Local development falls back to an in-memory per-runtime limiter.
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_TRUST_PROXY_HEADERS=
CONTACT_RATE_LIMIT_REDIS_REST_URL=
CONTACT_RATE_LIMIT_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_REDIS_TIMEOUT_MS=1500

# Listings API base for the (future) live listing system. Currently UNUSED:
# public listings are deferred for launch and /listings is a static placeholder
# (see DECISIONS.md 2026-06-22). Retained so the variable stays documented for
# when the live listing system is reintroduced.
LISTINGS_API_URL=
